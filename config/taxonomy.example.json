    "A/B testing":{ "cat": "method",    "status": "have",    "patterns": ["a/?b test", "experimentation", "hypothesis test"] },
    "Statistics": { "cat": "method",    "status": "have",    "patterns": ["statistic", "regression", "inference"] },
