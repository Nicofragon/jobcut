    "Looker":     { "cat": "viz",       "status": "gap",     "close_via": "cv-reframe", "patterns": ["looker"] },
    "dbt":        { "cat": "dataeng",   "status": "gap",     "close_via": "portfolio",  "patterns": ["\\bdbt\\b"] },
    "Airflow":    { "cat": "dataeng",   "status": "gap",     "close_via": "portfolio",  "patterns": ["airflow"] },
    "Spark":      { "cat": "dataeng",   "status": "gap",     "close_via": "course",     "patterns": ["py?spark"] },
    "ETL":        { "cat": "dataeng",   "status": "have",    "patterns": ["\\betls?\\b", "data pipelines?"] },
