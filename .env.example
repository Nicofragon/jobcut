# Copy to .env and fill in. .env is git-ignored — never commit it.

# Required: Apify API token (https://console.apify.com → Settings → API & Integrations).
# The pull step uses it to run the LinkedIn job scraper actor.
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: an LLM key (one of these) lets `jobcut import-cv` draft your profile from a
# CV and read interview rounds out of a job description. Scoring never needs it.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override where jobcut reads/writes data and outputs.
# Defaults to the current working directory.
# JOBCUT_DATA_DIR=/path/to/your/jobcut-data
